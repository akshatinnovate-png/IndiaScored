# Both settings are optional. With neither set, the app runs entirely in the
# browser: the model scores in JavaScript, data is kept in localStorage, and
# sign-in is a local demo account. That is how the GitHub Pages site runs.

# Clerk (https://dashboard.clerk.com) — omit for demo sign-in.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# FastAPI backend — omit to score and store in the browser.
# VITE_API_BASE_URL=http://localhost:8000

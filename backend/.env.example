# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=indiascored

# Model artifacts
MODEL_BUNDLE_PATH=artifacts/indiascored_pipeline_bundle.pkl
TOP_K_DRIVERS=5

# Local LLM used for underwriting remarks (optional; falls back to rule-based)
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=120

# Frontend origins allowed through CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
